<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BudgetAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="fontFamily">@font/outfit_regular</item>
    </style>
    <style name="SpinnerPopupStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@color/field_bg</item>
    </style>

    <style name="SpinnerItemStyle" parent="android:Widget.TextView.SpinnerItem">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/field_bg</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="PinKeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>