<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Eliminar tu cuenta?"
        android:textColor="@color/error_red"
        android:textSize="20sp"
        android:fontFamily="@font/outfit_bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Esta acción no se puede deshacer. Ingresa tu contraseña para confirmar."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/geist_regular"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="CONTRASEÑA ACTUAL"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_semibold"/>

    <EditText
        android:id="@+id/etPasswordConfirmacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:drawableStart="@drawable/ic_m3_lock"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="10dp"
        android:hint="Tu contraseña"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/outfit_regular"
        android:inputType="textPassword"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/tvDeleteError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/error_red"
        android:textSize="12sp"
        android:visibility="gone"
        android:fontFamily="@font/geist_regular"/>

    <Button
        android:id="@+id/btnConfirmarEliminar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_field_error"
        android:text="Eliminar cuenta permanentemente"
        android:textColor="@color/error_red"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:fontFamily="@font/geist_bold"
        android:textSize="15sp"/>

</LinearLayout>