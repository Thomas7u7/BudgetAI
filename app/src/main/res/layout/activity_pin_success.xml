<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Seguridad de ahorro"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:fontFamily="@font/outfit_bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_success">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="@color/green_primary"
                android:textSize="36sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PIN Creado Correctamente"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:fontFamily="@font/outfit_bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Tu PIN de seguridad de 4 dígitos ha sido configurado exitosamente. Ahora podrás autorizar depósitos y retiros de manera segura."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/geist_regular"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btnContinuar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center"
        android:background="@drawable/bg_button_primary"
        android:text="Ir a mi ahorro"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:fontFamily="@font/geist_bold"
        android:textSize="16sp"/>

</LinearLayout>