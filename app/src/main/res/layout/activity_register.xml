<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo + botón cerrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_button_primary">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="Logo Sparkle"
                            android:src="@drawable/ic_sparkle" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Budget"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/outfit_bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI"
                            android:textColor="@color/green_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/outfit_bold"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Únete a BudgetAI"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:fontFamily="@font/outfit_bold"/>

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Crea tu cuenta y empieza a gestionar tu dinero con inteligencia artificial."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular"/>

            <!-- Nombre completo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="NOMBRE COMPLETO"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"
                android:letterSpacing="0"/>

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@drawable/ic_m3_person"
                android:drawableTint="@color/text_secondary"
                android:drawablePadding="10dp"
                android:hint="Ingresa tu nombre"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/outfit_regular"
                android:inputType="textPersonName"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvFullNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CORREO ELECTRÓNICO"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"
                android:letterSpacing="0"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@drawable/ic_m3_mail"
                android:drawableTint="@color/text_secondary"
                android:drawablePadding="10dp"
                android:hint="Ingresa tu correo"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/outfit_regular"
                android:inputType="textEmailAddress"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CONTRASEÑA"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"
                android:letterSpacing="0"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:drawableStart="@drawable/ic_m3_lock"
                    android:drawableTint="@color/text_secondary"
                    android:drawablePadding="10dp"
                    android:hint="Crea una contraseña"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/outfit_regular"
                    android:inputType="textPassword"
                    android:singleLine="true"/>

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="Mostrar/Ocultar contraseña"
                    app:tint="@color/text_secondary"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Confirmar contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CONFIRMAR CONTRASEÑA"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"
                android:letterSpacing="0"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:drawableStart="@drawable/ic_m3_lock"
                    android:drawableTint="@color/text_secondary"
                    android:drawablePadding="10dp"
                    android:hint="Confirma tu contraseña"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/outfit_regular"
                    android:inputType="textPassword"
                    android:singleLine="true"/>

                <ImageButton
                    android:id="@+id/btnToggleConfirmPassword"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="Mostrar/Ocultar contraseña"
                    app:tint="@color/text_secondary"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Botón crear cuenta -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="Crear cuenta"
                android:textColor="@color/bg_dark"
                android:fontFamily="@font/outfit_semibold"
                android:textAllCaps="false"
                android:elevation="4dp"/>

            <!-- Divisor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="o continuar con"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_regular"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border"/>
            </LinearLayout>

            <!-- Google / Apple -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnGoogle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_button_social"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="Google"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnApple"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_social"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_apple"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="Apple"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Ya tienes cuenta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes cuenta? "
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_regular"/>

                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iniciar sesión"
                    android:textColor="@color/green_primary"
                    android:fontFamily="@font/outfit_bold"
                    android:textSize="14sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Overlay de loading -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC0A0E1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/green_primary"/>

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Creando tu cuenta..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/geist_regular"/>

    </LinearLayout>

</FrameLayout>