<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- Header: logo + avatar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_primary">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sparkle" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Budget"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textColor="@color/green_primary"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_bold"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carlos M."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/geist_semibold"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="@drawable/bg_circle_avatar"
            android:padding="6dp"
            app:tint="@color/text_secondary"/>

    </LinearLayout>

    <!-- Punto central invisible -->
    <View
        android:id="@+id/centerPoint"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="190dp"/>

    <!-- Tarjeta central de saldo -->
    <LinearLayout
        android:id="@+id/cardSaldo"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_field"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="@id/centerPoint"
        app:layout_constraintBottom_toBottomOf="@id/centerPoint"
        app:layout_constraintStart_toStartOf="@id/centerPoint"
        app:layout_constraintEnd_toEndOf="@id/centerPoint">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SALDO DISPONIBLE"
            android:textColor="@color/green_primary"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/geist_semibold"/>

        <!-- TODO: conectar con Firestore cuando exista el módulo Movimientos -->
        <TextView
            android:id="@+id/tvSaldo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="$12.450,00"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit_bold"/>

    </LinearLayout>

    <!-- Enviar (arriba centro) -->
    <LinearLayout
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="0">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enviar"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Meta (arriba izquierda) -->
    <LinearLayout
        android:id="@+id/btnMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="310">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Meta"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Código QR (arriba derecha) -->
    <LinearLayout
        android:id="@+id/btnQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="50">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Código QR"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Disponible (izquierda) -->
    <LinearLayout
        android:id="@+id/btnDisponible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="270">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Disponible"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Alertas (derecha) -->
    <LinearLayout
        android:id="@+id/btnAlertas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="90">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alertas"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Gastos (abajo izquierda) -->
    <LinearLayout
        android:id="@+id/btnGastos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="230">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gastos"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Movimientos (abajo derecha) -->
    <LinearLayout
        android:id="@+id/btnMovimientos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="130">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Movimientos"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Ahorro (abajo centro) -->
    <LinearLayout
        android:id="@+id/btnAhorro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintCircle="@id/centerPoint"
        app:layout_constraintCircleRadius="150dp"
        app:layout_constraintCircleAngle="180">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@android:drawable/ic_menu_save"
            app:tint="@color/text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ahorro"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Tarjeta: Consejo del día -->
    <LinearLayout
        android:id="@+id/cardConsejo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_field"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/centerPoint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="190dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_primary">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sparkle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSEJO DEL DÍA"
                android:textColor="@color/green_primary"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/geist_semibold"/>

            <!-- TODO: conectar con IA cuando exista el módulo de recomendaciones -->
            <TextView
                android:id="@+id/tvConsejo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="&quot;Tu meta de ahorro mensual está al 84%. Vas excelente.&quot;"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/geist_regular"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>