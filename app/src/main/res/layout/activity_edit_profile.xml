<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Editar Perfil"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit_bold"/>
            </LinearLayout>

            <!-- Avatar editable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="@drawable/bg_circle_avatar"
                        android:padding="22dp"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        app:tint="@color/text_secondary"/>

                    <ImageView
                        android:id="@+id/btnCambiarFoto"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_button_primary"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/bg_dark"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCambiarFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cambiar foto de perfil"
                    android:textColor="@color/green_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_semibold"/>
            </LinearLayout>

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="NOMBRE COMPLETO"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"/>

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawableTint="@color/text_secondary"
                android:drawablePadding="10dp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/outfit_regular"
                android:inputType="textPersonName"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvNombreError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Correo (solo lectura) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CORREO ELECTRÓNICO"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"/>

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawableTint="@color/text_secondary"
                android:drawablePadding="10dp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/outfit_regular"
                android:inputType="textEmailAddress"
                android:enabled="false"
                android:singleLine="true"/>

            <!-- Teléfono -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="NÚMERO DE TELÉFONO"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_semibold"/>

            <EditText
                android:id="@+id/etTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@android:drawable/ic_menu_call"
                android:drawableTint="@color/text_secondary"
                android:drawablePadding="10dp"
                android:hint="Ej: +57 300 1234567"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/outfit_regular"
                android:inputType="phone"
                android:singleLine="true"/>

            <!-- Botón guardar -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:text="Guardar cambios"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/geist_bold"
                android:textSize="16sp"/>

            <include layout="@layout/layout_status_banner"/>
        </LinearLayout>
    </ScrollView>

    <!-- Overlay de loading -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC0A0E1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/green_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Guardando cambios..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

</FrameLayout>