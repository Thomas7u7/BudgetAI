<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/field_bg"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/navMiAhorro"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavMiAhorro"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_m3_wallet"
            app:tint="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvNavMiAhorro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mi Ahorro"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMetas"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavMetas"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_m3_flag"
            app:tint="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvNavMetas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Metas"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navAhorroIA"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavAhorroIA"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvNavAhorroIA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="AhorroIA"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

</LinearLayout>