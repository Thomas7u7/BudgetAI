<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Depósito de ahorro"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:fontFamily="@font/outfit_bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="40dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_success">

            <TextView
                android:id="@+id/tvIcono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="@color/green_primary"
                android:textSize="36sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Depósito Exitoso"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:fontFamily="@font/outfit_bold"/>

        <TextView
            android:id="@+id/tvMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/geist_regular"/>
    </LinearLayout>

    <!-- Resumen (solo visible en casos exitosos) -->
    <LinearLayout
        android:id="@+id/cardResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_field"
        android:padding="16dp"
        android:layout_marginTop="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/tvEtiquetaMonto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Monto depositado" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="@font/geist_regular"/>
            <TextView android:id="@+id/tvMonto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0" android:textColor="@color/green_primary" android:textSize="14sp" android:fontFamily="@font/geist_bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Meta destino" android:textColor="@color/text_secondary" android:textSize="13sp" android:fontFamily="@font/geist_regular"/>
            <TextView android:id="@+id/tvMetaDestino" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="@font/geist_semibold"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/btnPrincipal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center"
        android:background="@drawable/bg_button_primary"
        android:text="Volver al ahorro"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:fontFamily="@font/geist_bold"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/btnSecundario"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Salir"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/geist_semibold"
        android:textSize="14sp"/>

</LinearLayout>