<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Ahorros BudgetIA"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:fontFamily="@font/outfit_bold"/>
            </LinearLayout>

            <!-- Tarjeta saldo total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_saldo"
                android:padding="18dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo total ahorrado"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/geist_semibold"/>

                    <TextView
                        android:id="@+id/tvSaldoTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="$0 COP"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit_bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Botones de acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/btnAgregar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_primary"
                    android:text="+ Agregar"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/geist_bold"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/btnRetirar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_field"
                    android:text="Retirar"
                    android:textColor="@color/text_primary"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="@font/geist_semibold"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/btnHistorial"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_field"
                    android:text="Historial"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/geist_semibold"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Meta activa -->
            <LinearLayout
                android:id="@+id/cardMetaActiva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_field"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="META ACTIVA"
                    android:textColor="@color/green_primary"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/geist_semibold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvNombreMeta"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="@font/geist_semibold"/>

                    <TextView
                        android:id="@+id/tvPorcentajeMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/green_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/geist_bold"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressMeta"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/green_primary"
                    android:progressBackgroundTint="@color/field_border"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvAhorradoMeta"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Ahorrado\n$0"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/geist_regular"/>

                    <TextView
                        android:id="@+id/tvFaltanteMeta"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Dinero faltante\n$0"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:fontFamily="@font/geist_regular"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Estado vacío (sin metas) -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_field"
                android:padding="24dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="28sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Aún no tienes una meta de ahorro"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/geist_semibold"/>

                <TextView
                    android:id="@+id/btnCrearMetaVacio"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_primary"
                    android:text="Crear mi primera meta"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:paddingHorizontal="18dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/geist_bold"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Consejo IA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_field"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_sparkle"/>

                <TextView
                    android:id="@+id/tvConsejoIA"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="BudgetIA te aconseja"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_regular"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_savings_bottom_nav"/>

    <!-- Overlay de loading, fuera del scroll para cubrir toda la pantalla -->

</LinearLayout>