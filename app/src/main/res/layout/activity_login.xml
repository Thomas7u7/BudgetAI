<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo + nombre -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_primary">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sparkle" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit_extrabold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI"
                    android:textColor="@color/green_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit_extrabold"/>

            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Bienvenido de nuevo"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit_bold"/>

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tu dinero, inteligente. Toma el control total de tus finanzas y optimiza tus presupuestos con el poder de la IA."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <!-- Label correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="CORREO ELECTRÓNICO"
                android:textColor="@color/green_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="@font/geist_semibold"/>

            <!-- Campo correo -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@drawable/ic_m3_mail"
                android:drawableTint="@color/green_primary"
                android:drawablePadding="10dp"
                android:hint="Ingresa tu correo"
                android:textColorHint="@color/text_primary"
                android:textColor="@color/text_primary"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:fontFamily="@font/geist_regular"/>

            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Correo electrónico inválido"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Label contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CONTRASEÑA"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <!-- Campo contraseña -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:drawableStart="@drawable/ic_m3_lock"
                android:drawableTint="@color/green_primary"
                android:drawablePadding="10dp"
                android:hint="Ingresa tu contraseña"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:inputType="textPassword"
                android:singleLine="true"
                android:fontFamily="@font/geist_regular"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Correo o contraseña incorrectos"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                android:fontFamily="@font/geist_regular"/>

            <!-- Olvidé contraseña -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:text="¿Olvidé mi contraseña?"
                android:textColor="@color/green_primary"
                android:textSize="13sp"/>

            <!-- Botón iniciar sesión -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:text="Iniciar sesión"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:elevation="4dp"
                android:backgroundTint="@null"
                android:fontFamily="@font/geist_bold"
                android:textSize="16sp"
                android:letterSpacing="0.01"/>

            <!-- Divisor "o continuar con" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="o continuar con"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/field_border"/>
            </LinearLayout>

            <!-- Botones Google / Apple -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnGoogle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_social"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:fontFamily="@font/geist_semibold"
                    android:text="Google"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:letterSpacing="0.01"/>

                <Button
                    android:id="@+id/btnApple"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_social"
                    android:fontFamily="@font/geist_semibold"
                    android:text="Apple"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_apple"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@null"
                    android:letterSpacing="0.01"/>
            </LinearLayout>

            <!-- Crear cuenta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes una cuenta? "
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/geist_regular"/>

                <TextView
                    android:id="@+id/tvCreateAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crear cuenta"
                    android:textColor="@color/green_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/geist_bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Overlay de loading -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC0A0E1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/green_primary"/>

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Iniciando sesión..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/geist_regular"/>

    </LinearLayout>

</FrameLayout>