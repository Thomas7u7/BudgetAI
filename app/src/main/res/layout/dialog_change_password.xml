<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cambiar contraseña"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="@font/outfit_bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="CONTRASEÑA ACTUAL"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_semibold"/>

    <EditText
        android:id="@+id/etPasswordActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:drawableStart="@android:drawable/ic_lock_idle_lock"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="10dp"
        android:hint="Tu contraseña actual"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/outfit_regular"
        android:inputType="textPassword"
        android:singleLine="true"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="NUEVA CONTRASEÑA"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_semibold"/>

    <EditText
        android:id="@+id/etNuevaPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:drawableStart="@android:drawable/ic_lock_idle_lock"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="10dp"
        android:hint="Mínimo 8 caracteres"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/outfit_regular"
        android:inputType="textPassword"
        android:singleLine="true"/>

    <!-- Medidor de fortaleza -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <View
            android:id="@+id/barraFortaleza1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@color/field_border"/>

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"/>

        <View
            android:id="@+id/barraFortaleza2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@color/field_border"/>

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"/>

        <View
            android:id="@+id/barraFortaleza3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@color/field_border"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFortaleza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="11sp"
        android:fontFamily="@font/geist_semibold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="CONFIRMAR NUEVA CONTRASEÑA"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_semibold"/>

    <EditText
        android:id="@+id/etConfirmarPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:drawableStart="@android:drawable/ic_lock_idle_lock"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="10dp"
        android:hint="Repite la contraseña"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/outfit_regular"
        android:inputType="textPassword"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/tvPasswordError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/error_red"
        android:textSize="12sp"
        android:visibility="gone"
        android:fontFamily="@font/geist_regular"/>

    <Button
        android:id="@+id/btnActualizarPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"
        android:text="Actualizar contraseña"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:fontFamily="@font/geist_bold"
        android:textSize="16sp"/>

</LinearLayout>